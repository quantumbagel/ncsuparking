# ── Docker Compose Environment ───────────────────────────────────────────────
# Copy this file to .env and customize if desired.
# The defaults below work out of the box with docker-compose.yml.

# PostgreSQL (DB_HOST should stay "db" — the Docker service name)
DB_HOST=db
DB_PORT=5432
DB_NAME=ncsuparking
DB_USER=postgres
DB_PASSWORD=ncsuparking

# Parking poll interval in seconds (10s for high-resolution timestamps)
POLL_INTERVAL=10

# Events poll interval in seconds (3600 = hourly)
EVENT_POLL_INTERVAL=3600

# Prediction interval in seconds (60 = every minute)
PREDICT_INTERVAL=60

# How many days ahead to fetch events
EVENT_DAYS=30

# Auto-retrain interval in seconds (86400 = daily)
RETRAIN_INTERVAL=86400

# NCSU APIs
PARKING_API_URL=https://transportation.ncsu.edu/wp-json/ncsu-transportation-parking-view/v1/get-parking-data
EVENTS_API_URL=https://calendar.ncsu.edu/api/2/events
