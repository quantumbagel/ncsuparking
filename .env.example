# Copy this file to .env and customize if desired.
# The defaults work out of the box with docker compose.

# PostgreSQL (DB_HOST should stay "db" — the Docker service name)
DB_HOST=db
DB_PORT=5432
DB_NAME=ncsuparking
DB_USER=postgres
DB_PASSWORD=ncsuparking

# Display + model clock (snapshots are still stored in UTC)
TIMEZONE=America/New_York

# Parking poll interval in seconds
POLL_INTERVAL=10

# Events poll interval in seconds (3600 = hourly)
EVENT_POLL_INTERVAL=3600

# Prediction interval in seconds (60 = every minute)
PREDICT_INTERVAL=60

# Forecast grid and horizons
GRID_MINUTES=5
FORECAST_HORIZONS=15,30,60,120,180,360,720,1440

# Keep prediction history this long (days)
PREDICTION_RETENTION_DAYS=14

# How many days ahead to fetch events
EVENT_DAYS=30

# Auto-retrain at most this often (seconds). The collector also
# checks hourly and trains immediately when no baseline exists.
RETRAIN_INTERVAL=86400
RETRAIN_CHECK_INTERVAL=3600
TRAIN_REQUEST_POLL=15

# NCSU APIs
PARKING_API_URL=https://transportation.ncsu.edu/wp-json/ncsu-transportation-parking-view/v1/get-parking-data
EVENTS_API_URL=https://calendar.ncsu.edu/api/2/events
